#!/usr/bin/env bash

# HELP adbw --help; adb wrapper for common usecases.

_depends-on adb || exit

show-usage () {
    echo "Usage: adb wrapper for common usecases.
       adbw connect <ip>|<ip:port>  # connect over wifi; port optional (mDNS discovery, legacy 5555 fallback)
       adbw pair <ip:pair-port> [code]  # pair via wireless debugging (code prompted if omitted)
       adbw devices ls  # list all devices
       adbw devices debloat-rootless  # debloat device rootlessly
       adbw devices toggle-screen  # toggle the screen for device
       adbw package ls  # list all packages 
       adbw package clear <package-name>  # clear cache & data of package-name
       adbw package remove <package-name>  # uninstall package-name
       adbw package disable <fully.qualified.name>  # disable package using fully qualified name"
}

adb-devices () (
    subcommand="$1"
    case "$subcommand" in
        ls)
            # "device" state is the correct state here for authorized devices
            adb devices | awk '{ if (NR > 1) { printf $1 " " } }' | xargs
            ;;
        debloat-rootless)
            set -x  # showcase what we're installing / uninstalling

            adb uninstall --user 0 com.aura.oobe.samsung.gl
            adb uninstall --user 0 com.aura.oobe.samsung
            adb uninstall --user 0 com.ironsource.appcloud.oobe.hutchison
            adb uninstall --user 0 com.google.android.googlequicksearchbox
            adb uninstall --user 0 com.samsung.android.kidsinstaller
            adb uninstall --user 0 com.samsung.android.game.gamehome
            adb uninstall --user 0 com.samsung.android.game.gos
            adb uninstall --user 0 com.samsung.android.game.gametools
            adb uninstall --user 0 com.samsung.android.app.spage

            set +x
            ;;
        toggle-screen)
            adb shell input keyevent KEYCODE_POWER
            ;;
        *)
            echo "Unknown device argument: ${subcommand:=NONE PROVIDED}"
            show-usage
            exit 2
            ;;
    esac
)

adb-package () (
    subcommand="$1"
    package_named="${@:2}"
    requires-package-named () {
        if [[ -z "$package_named" ]]; then
            echo "package-name must be given!"
            show-usage
            exit 2
        fi
    }

    case "$subcommand" in
        ls)
            adb shell cmd package list packages | cut -c 9-
            ;;
        clear)
            requires-package-named
            adb shell pm clear "$package_named"
            ;;
        remove)
            requires-package-named
            adb uninstall --user 0 "$package_named"
            ;;
        disable)
            requires-package-named
            for pkg in "${@:2}"; do
                adb uninstall --user 0 "$pkg"
            done
            ;;
        *)
            echo "Unknown package argument: ${subcommand:=NONE PROVIDED}"
            show-usage
            exit 2
            ;;
    esac
)

# Android 11+ wireless debugging uses random ports, NOT 5555:
#   - pair port:  Developer options -> Wireless debugging -> "Pair device with pairing code"
#   - connect port: Developer options -> Wireless debugging -> "IP address & Port"
adb-connect () (
    ip="${1:-}"
    if [[ -z $ip ]]; then echo "device ip (or ip:port) must be given!"; show-usage; exit 2; fi

    # explicit port given: use it verbatim
    if [[ $ip == *:* ]]; then
        adb connect "$ip"
        exit
    fi

    # no port: try mDNS discovery for this device's connect port
    discovered="$(adb mdns services 2>/dev/null \
        | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}:[0-9]+' \
        | grep -F "$ip" | head -n 1)"
    if [[ -n $discovered ]]; then
        echo "mDNS: $ip -> $discovered"
        adb connect "$discovered"
        exit
    fi

    # legacy fallback: classic 'adb tcpip 5555' (usb-initiated) workflow
    if adb connect "$ip:5555" | grep -qE '^(connected|already connected) to '; then
        exit
    fi

    echo "failed to connect to $ip"
    echo "  Android 11+ wireless debugging does not use port 5555. Either:"
    echo "    adbw pair $ip:<pair-port> <code>     # from 'Pair device with pairing code' dialog"
    echo "    adbw connect $ip:<connect-port>      # from 'IP address & Port' on the Wireless debugging screen"
    exit 1
)

adb-pair () (
    addr="${1:-}"
    code="${2:-}"
    if [[ -z $addr ]]; then echo "ip:pair-port must be given!"; show-usage; exit 2; fi

    if [[ -n $code ]]; then
        adb pair "$addr" "$code"
    else
        adb pair "$addr"   # adb prompts for the pairing code itself
    fi || exit 1

    # pairing != connecting; the connect port differs from the pair port.
    # give mDNS a moment to advertise it, then try to connect.
    sleep 2
    ip="${addr%%:*}"
    adb-connect "$ip" || true
)

main () {
    if [[ $# -eq 0 ]]; then
        show-usage
        exit 2
    fi

    for ((i=1; i<=$#; i++)); do
        arg="${!i}"
        case "$arg" in
            -h|--help)
                show-usage
                exit 0
                ;;
            connect)
                ((i++))
                adb-connect "${@:$i}" || exit
                exit
                ;;
            pair)
                ((i++))
                adb-pair "${@:$i}" || exit
                exit
                ;;
            devices)
                ((i++))
                adb-devices "${@:$i}"
                exit
                ;;
            package)
                ((i++))
                adb-package "${@:$i}"
                exit
                ;;
            *)
                echo "Unknown argument: $arg"
                show-usage
                exit 2
                ;;
        esac
    done
}

[[ "${BASH_SOURCE[0]}" == "${0}" ]] && main "$@"
