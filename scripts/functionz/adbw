#!/usr/bin/env bash

# HELP adbw --help; adb wrapper for common usecases.

_depends-on adb || exit

show-usage () {
    echo "Usage: adb wrapper for common usecases.
       adbw -s <serial> <command>  # target a specific device (needed when several are connected)
       adbw connect <ip>|<ip:port>  # connect over wifi; port optional (mDNS discovery, legacy 5555 fallback)
       adbw pair <ip:pair-port> [code]  # pair via wireless debugging (code prompted if omitted)
       adbw devices ls  # list all devices
       adbw devices debloat-rootless  # debloat device rootlessly
       adbw devices toggle-screen  # toggle the screen for device
       adbw package ls  # list all packages 
       adbw package clear <package-name>  # clear cache & data of package-name
       adbw package remove <package-name>  # uninstall package-name
       adbw package disable <fully.qualified.name>  # disable package using fully qualified name
       adbw package kill <package-name>  # force-stop package-name
       adbw install <apk> [flags]  # install apk (replaces existing, keeps its data); extra flags pass to adb install (e.g. -d to allow downgrade)
       adbw log dump [pkg] [logcat-args]  # static (non-live) logs; extra args pass to logcat (-T '<time>' ~ --since, -t <n> ~ tail)
       adbw log follow [pkg]  # live logs (like journalctl -f)
       adbw log crash [pkg]  # crash buffer only
       adbw log clear  # wipe log buffers
       adbw log size"  # ring buffer sizes (like journalctl --disk-usage)
}

adb-devices () (
    subcommand="$1"
    case "$subcommand" in
        ls)
            # "device" state is the correct state here for authorized devices
            adb devices | awk '{ if (NR > 1) { printf $1 " " } }' | xargs
            ;;
        debloat-rootless)
            set -x  # showcase what we're installing / uninstalling

            adb uninstall --user 0 com.aura.oobe.samsung.gl
            adb uninstall --user 0 com.aura.oobe.samsung
            adb uninstall --user 0 com.ironsource.appcloud.oobe.hutchison
            adb uninstall --user 0 com.google.android.googlequicksearchbox
            adb uninstall --user 0 com.samsung.android.kidsinstaller
            adb uninstall --user 0 com.samsung.android.game.gamehome
            adb uninstall --user 0 com.samsung.android.game.gos
            adb uninstall --user 0 com.samsung.android.game.gametools
            adb uninstall --user 0 com.samsung.android.app.spage

            set +x
            ;;
        toggle-screen)
            adb shell input keyevent KEYCODE_POWER
            ;;
        *)
            echo "Unknown device argument: ${subcommand:=NONE PROVIDED}"
            show-usage
            exit 2
            ;;
    esac
)

adb-package () (
    subcommand="$1"
    package_named="${2:-}"
    requires-package-named () {
        if [[ -z "$package_named" ]]; then
            echo "package-name must be given!"
            show-usage
            exit 2
        fi
    }

    case "$subcommand" in
        ls)
            adb shell cmd package list packages | cut -c 9-
            ;;
        clear)
            requires-package-named
            adb shell pm clear "$package_named"
            ;;
        remove)
            requires-package-named
            adb uninstall --user 0 "$package_named"
            ;;
        disable)
            requires-package-named
            for pkg in "${@:2}"; do
                adb uninstall --user 0 "$pkg"
            done
            ;;
        kill)
            requires-package-named
            adb shell am force-stop "$package_named"
            ;;
        *)
            echo "Unknown package argument: ${subcommand:=NONE PROVIDED}"
            show-usage
            exit 2
            ;;
    esac
)

# journalctl-style log viewing. pkg filter resolves to a uid where possible so old
# (pre-restart) entries still match in static dumps; running non-package processes
# (system_server etc.) fall back to a live pid filter.
adb-log () (
    subcommand="$1"
    pkg="${2:-}"
    extra=()

    # allow leading flags without a pkg filter: adbw log dump -b events
    if [[ "$pkg" == -* ]]; then
        extra=("${@:2}")
        pkg=""
    else
        extra=("${@:3}")
    fi

    # adb's bare 'more than one device' error is unhelpful; disambiguate upfront
    if [[ -z "$ANDROID_SERIAL" ]]; then
        connected="$(adb devices | awk 'NR > 1 && $2 == "device" {print "  " $1}')"
        if (( $(wc -l <<<"$connected") > 1 )); then
            echo "multiple devices connected; target one with: adbw -s <serial> log ..."
            echo "$connected"
            exit 1
        fi
    fi

    resolve-filter () {
        local name="$1" uid pid

        uid="$(adb shell pm list packages -U "$name" 2>/dev/null | tr -d '\r' \
            | grep -oE 'uid:[0-9]+' | head -n1 | cut -d: -f2)"
        if [[ -n "$uid" ]]; then
            echo "--uid=$uid"
            return 0
        fi

        # older devices without 'pm list -U'
        uid="$(adb shell dumpsys package "$name" 2>/dev/null | tr -d '\r' \
            | grep -m1 -oE 'userId=[0-9]+' | cut -d= -f2)"
        if [[ -n "$uid" ]]; then
            echo "--uid=$uid"
            return 0
        fi

        pid="$(adb shell pidof "$name" 2>/dev/null | tr -d '\r' | awk '{print $1}')"
        if [[ -n "$pid" ]]; then
            echo "--pid=$pid"
            return 0
        fi

        echo "could not resolve '$name' to a package uid or running pid" >&2
        return 1
    }

    filter=()
    if [[ -n "$pkg" ]]; then
        filter=("$(resolve-filter "$pkg")") || exit 1
    fi

    case "$subcommand" in
        dump)
            # static, non-live (journalctl with no flags)
            adb logcat -d "${filter[@]}" "${extra[@]}"
            ;;
        follow)
            # live tail (journalctl -f)
            adb logcat "${filter[@]}" "${extra[@]}"
            ;;
        crash)
            adb logcat -d -b crash "${filter[@]}" "${extra[@]}"
            ;;
        clear)
            adb logcat -c
            ;;
        size)
            adb logcat -g
            ;;
        *)
            echo "Unknown log argument: ${subcommand:=NONE PROVIDED}"
            show-usage
            exit 2
            ;;
    esac
)

# apk install; -r (replace existing, keep data) is the dev-workflow default.
# common failure modes get an actionable hint instead of adb's bare error.
adb-install () (
    apk="${1:-}"
    if [[ -z "$apk" ]]; then
        echo "apk path must be given!"
        show-usage
        exit 2
    fi
    if [[ "$apk" == -* ]]; then
        echo "apk path must come first; adb flags go after it (adbw install app.apk -d)"
        exit 2
    fi
    if [[ ! -f "$apk" ]]; then
        echo "no such file: $apk"
        exit 2
    fi
    extra=("${@:2}")

    # adb's bare 'more than one device' error is unhelpful; disambiguate upfront
    if [[ -z "$ANDROID_SERIAL" ]]; then
        connected="$(adb devices | awk 'NR > 1 && $2 == "device" {print "  " $1}')"
        if (( $(wc -l <<<"$connected") > 1 )); then
            echo "multiple devices connected; target one with: adbw -s <serial> install ..."
            echo "$connected"
            exit 1
        fi
    fi

    output="$(adb install -r "$apk" "${extra[@]}" 2>&1)"
    status=$?
    echo "$output"

    if (( status != 0 )); then
        if grep -q 'INSTALL_FAILED_UPDATE_INCOMPATIBLE' <<<"$output"; then
            pkg="$(grep -oE 'Package [a-zA-Z0-9._]+' <<<"$output" | head -n1 | cut -d' ' -f2)"
            echo "installed copy has a different signature (e.g. store build vs locally signed); to replace it:"
            echo "  adbw package remove ${pkg:-<package-name>}"
            echo "  note: removal is refused while the app is the default for a role (e.g. active home launcher) - switch defaults first"
        elif grep -q 'INSTALL_FAILED_VERSION_DOWNGRADE' <<<"$output"; then
            echo "installed version is newer; allow the downgrade with:"
            echo "  adbw install $apk -d"
        fi
    fi
    exit $status
)

# Android 11+ wireless debugging uses random ports, NOT 5555:
#   - pair port:  Developer options -> Wireless debugging -> "Pair device with pairing code"
#   - connect port: Developer options -> Wireless debugging -> "IP address & Port"
adb-connect () (
    ip="${1:-}"
    if [[ -z $ip ]]; then echo "device ip (or ip:port) must be given!"; show-usage; exit 2; fi

    # explicit port given: use it verbatim
    if [[ $ip == *:* ]]; then
        adb connect "$ip"
        exit
    fi

    # no port: try mDNS discovery for this device's connect port
    discovered="$(adb mdns services 2>/dev/null \
        | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}:[0-9]+' \
        | grep -F "$ip" | head -n 1)"
    if [[ -n $discovered ]]; then
        echo "mDNS: $ip -> $discovered"
        adb connect "$discovered"
        exit
    fi

    # legacy fallback: classic 'adb tcpip 5555' (usb-initiated) workflow
    if adb connect "$ip:5555" | grep -qE '^(connected|already connected) to '; then
        exit
    fi

    echo "failed to connect to $ip"
    echo "  Android 11+ wireless debugging does not use port 5555. Either:"
    echo "    adbw pair $ip:<pair-port> <code>     # from 'Pair device with pairing code' dialog"
    echo "    adbw connect $ip:<connect-port>      # from 'IP address & Port' on the Wireless debugging screen"
    exit 1
)

adb-pair () (
    addr="${1:-}"
    code="${2:-}"
    if [[ -z $addr ]]; then echo "ip:pair-port must be given!"; show-usage; exit 2; fi

    if [[ -n $code ]]; then
        adb pair "$addr" "$code"
    else
        adb pair "$addr"   # adb prompts for the pairing code itself
    fi || exit 1

    # pairing != connecting; the connect port differs from the pair port.
    # give mDNS a moment to advertise it, then try to connect.
    sleep 2
    ip="${addr%%:*}"
    adb-connect "$ip" || true
)

main () {
    if [[ $# -eq 0 ]]; then
        echo "No command given!"
        show-usage
        exit 2
    fi

    for ((i=1; i<=$#; i++)); do
        arg="${!i}"
        case "$arg" in
            -h|--help)
                show-usage
                exit 0
                ;;
            -s|--serial)
                ((i++))
                serial="${!i}"
                if [[ -z "$serial" ]]; then
                    echo "serial must be given after -s"
                    show-usage
                    exit 2
                fi
                # all nested adb calls (log/package/devices shell outs) target this device
                export ANDROID_SERIAL="$serial"
                ;;
            connect)
                ((i++))
                adb-connect "${@:$i}" || exit
                exit
                ;;
            pair)
                ((i++))
                adb-pair "${@:$i}" || exit
                exit
                ;;
            devices)
                ((i++))
                adb-devices "${@:$i}"
                exit
                ;;
            package)
                ((i++))
                adb-package "${@:$i}"
                exit
                ;;
            log)
                ((i++))
                adb-log "${@:$i}"
                exit
                ;;
            install)
                ((i++))
                adb-install "${@:$i}"
                exit
                ;;
            *)
                echo "Unknown argument: $arg"
                show-usage
                exit 2
                ;;
        esac
    done

    # only flags were given (e.g. 'adbw -s <serial>'): nothing was dispatched
    echo "No command given!"
    show-usage
    exit 2
}

[[ "${BASH_SOURCE[0]}" == "${0}" ]] && main "$@"
