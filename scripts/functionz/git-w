GITIGNORE_EOF
        echo "  ✓ Created ${gitignore_path}"
    fi

    # ── 3. Install git hooks ─────────────────────────────────────────────────

    # ── pre-commit: block STOPSHIP ───────────────────────────────────────────
    local pre_commit="${hooks_dir}/pre-commit"
    if [[ -f "$pre_commit" ]] && [[ -s "$pre_commit" ]]; then
        echo "→ Hook 'pre-commit' already exists — skipping (remove ${pre_commit} to reinstall)"
    else
        echo "→ Installing pre-commit hook (STOPSHIP blocker)..."
        cat > "$pre_commit" << 'PRE_COMMIT_EOF'
#!/usr/bin/env bash
# git-w: block commits that contain STOPSHIP markers

matches=$(git diff --cached | grep '^+' | grep -v '^+++' | grep -F 'STOPSHIP')
if [[ -n "$matches" ]]; then
    echo "" >&2
    echo "ERROR: Commit blocked — STOPSHIP marker found in staged changes:" >&2
    echo "" >&2
    echo "$matches" | sed 's/^+/  /' >&2
    echo "" >&2
    echo "  Resolve or remove all STOPSHIP markers before committing." >&2
    exit 1
fi
exit 0
PRE_COMMIT_EOF
        chmod +x "$pre_commit"
        echo "  ✓ pre-commit hook installed"
    fi

    # ── post-commit: report FIXMEs / TODOs ──────────────────────────────────
    local post_commit="${hooks_dir}/post-commit"
    if [[ -f "$post_commit" ]] && [[ -s "$post_commit" ]]; then
        echo "→ Hook 'post-commit' already exists — skipping (remove ${post_commit} to reinstall)"
    else
        echo "→ Installing post-commit hook (FIXME/TODO reporter)..."
        cat > "$post_commit" << 'POST_COMMIT_EOF'
#!/usr/bin/env bash
# git-w: report FIXMEs and TODOs introduced by this commit

if git rev-parse HEAD~1 >/dev/null 2>&1; then
    matches=$(git diff HEAD~1 HEAD | grep '^+' | grep -v '^+++' | grep -iE '\b(FIXME|TODO)\b')
else
    # Initial commit — use git show
    matches=$(git show HEAD   | grep '^+' | grep -v '^+++' | grep -iE '\b(FIXME|TODO)\b')
fi

if [[ -n "$matches" ]]; then
    echo ""
    echo "⚠  This commit introduces the following FIXMEs / TODOs:"
    echo "$matches" | sed 's/^+/  /'
    echo ""
fi
exit 0
POST_COMMIT_EOF
        chmod +x "$post_commit"
        echo "  ✓ post-commit hook installed"
    fi

    # ── commit-msg: enforce Conventional Commits or Jira ticket ID ───────────
    local commit_msg_hook="${hooks_dir}/commit-msg"
    if [[ -f "$commit_msg_hook" ]] && [[ -s "$commit_msg_hook" ]]; then
        echo "→ Hook 'commit-msg' already exists — skipping (remove ${commit_msg_hook} to reinstall)"
    else
        echo "→ Installing commit-msg hook (Conventional Commits / Jira enforcement)..."
        cat > "$commit_msg_hook" << 'COMMIT_MSG_EOF'
#!/usr/bin/env bash
# git-w: enforce Conventional Commits spec or a Jira ticket ID

commit_msg_file="$1"
# Strip comment lines, then take the first non-empty line as the subject
commit_subject=$(grep -v '^#' "$commit_msg_file" | sed '/^[[:space:]]*$/d' | head -1)

# Nothing to validate if the subject is empty (git will reject it anyway)
[[ -z "$commit_subject" ]] && exit 0

# Conventional Commits — https://www.conventionalcommits.org/
#   type(optional-scope)!: description
conventional='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+'

# Jira ticket ID — PROJ-123: …  |  [PROJ-123]: …  |  [PROJ-123] …
jira='^(\[[A-Z][A-Z0-9_]*-[0-9]+\]|[A-Z][A-Z0-9_]*-[0-9]+)[: ] .+'

if echo "$commit_subject" | grep -qE "$conventional"; then
    exit 0
fi

if echo "$commit_subject" | grep -qE "$jira"; then
    exit 0
fi

echo "" >&2
echo "ERROR: Commit message rejected — does not match Conventional Commits or Jira format." >&2
echo "" >&2
echo "  Conventional Commits (https://www.conventionalcommits.org/):" >&2
echo "    feat(auth): add OAuth2 login support" >&2
echo "    fix: resolve null pointer in UserService" >&2
echo "    chore(deps)!: drop support for Python 3.8" >&2
echo "" >&2
echo "  Valid types: feat  fix  docs  style  refactor  perf  test  build  ci  chore  revert" >&2
echo "" >&2
echo "  Jira ticket ID:" >&2
echo "    PROJ-1234: implement OAuth2 login" >&2
echo "    [PROJ-1234] implement OAuth2 login" >&2
echo "" >&2
echo "  Your subject: ${commit_subject}" >&2
echo "" >&2
exit 1
COMMIT_MSG_EOF
        chmod +x "$commit_msg_hook"
        echo "  ✓ commit-msg hook installed"
    fi

    echo ""
    echo "✓ git w init complete."
)

main () (
    subcommand="$1"
    subcommand_args=( "${@:2}" )
    case "$subcommand" in
        -h|--help)
            show-usage
            exit 0
            ;;
        status)
            git-w-st "${subcommand_args[@]}"
            ;;
        blame)
            git-w-bl "${subcommand_args[@]}"
            ;;
        changed)
            git-w-list-changed "${subcommand_args[@]}"
            ;;
        restore)
            git-w-restore "${subcommand_args[@]}"
            ;;
        nuke)
            git-w-nuke "${subcommand_args[@]}"
            ;;
        alias)
            git-w-alias
            ;;
        when)
            git-w-when "${subcommand_args[@]}"
            ;;
        ls)
            git-w-ls "${subcommand_args[@]}"
            ;;
        summary)
            git-w-summary
            ;;
        init)
            git-w-init
            ;;
        *)
            echo "Unknown subcommand: ${subcommand:=NONE PROVIDED}"
            show-usage
            exit 2
            ;;
    esac
)

[[ "${BASH_SOURCE[0]}" == "${0}" ]] && main "$@"
