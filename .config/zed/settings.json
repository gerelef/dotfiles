// https://zed.dev/docs/configuring-zed
//
// Highlighting FIXME TODO/FIXME with 'Comments Highlighter' extension.
{
    // ---------------- TELEMETRY ----------------
    // use defaults: "auto_update": true,
    "proxy": "",
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
        "anthropic_retention": false
    },
    // ---------------- VISUAL ----------------
    "hide_mouse": "never",
    // "buffer_font_size": 17,
    // "buffer_font_family": "Noto Sans Mono",
    // "ui_font_size": 17,
    // "ui_font_family": "Noto Sans Mono",
    // "agent_buffer_font_size": 17,
    // "agent_ui_font_size": 17,
    // "markdown_preview_font_family": "Noto Sans",
    "theme": {
        "mode": "system",
        "light": "Catppuccin Latte",
        "dark": "Catppuccin Mocha",
    },
    "project_panel": {
        "button": true,
        "dock": "left",
        "git_status": true,
    },
    "scrollbar": {
        "show": "system",
        "cursors": true,
        "git_diff": true,
        "search_results": true,
        "selected_symbol": true,
        "diagnostics": "information",
        "axes": { "horizontal": false },
    },
    "tab_bar": {
        "show": true,
        "show_nav_history_buttons": false,
        "show_pinned_tabs_in_separate_row": true,
        "show_tab_bar_buttons": true
    },
    "tabs": {
        "git_status": true,
        "show_close_button": "hidden",
        "close_position": null,
        "file_icons": false,
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
        "selections_menu": false,
        "agent_review": false,
        "code_actions": false,
    },
    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_value_hints": true,
        "show_other_hints": true,
        "show_background": false,
        "edit_debounce_ms": 700,
        "scroll_debounce_ms": 50,
    },
    // ---------------- BEHAVIOURAL ----------------
    "confirm_quit": true,
    "base_keymap": "JetBrains",
    "seed_search_query_from_cursor": "selection",
    "middle_click_paste": false,
    "vertical_scroll_margin": 0,
    "restore_on_startup": "last_session",
    "session": { "restore_unsaved_buffers": true },
    "autosave": { "after_delay": { "milliseconds": 60000 } },
    // ---------------- INDENTATION ----------------
    "indent_guides": {
        "enabled": true,
        "line_width": 1,
        "active_line_width": 2,
        "coloring": "fixed",
        "background_coloring": "disabled",
    },
    "preferred_line_length": 100,
    "wrap_guides": [100],
    "hard_tabs": false,
    "tab_size": 4,
    // ---------------- EDITOR SETTINGS ----------------
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": { "location": "status_bar", "enabled": true, "show_commit_summary": true },
    },
    "enable_language_server": true,
    "ensure_final_newline_on_save": false, // disabled for edge cases;
    "format_on_save": "off",
    "formatter": "auto",
    "use_autoclose": true,
    "soft_wrap": "none",
    "always_treat_brackets_as_autoclosed": true,
    "show_whitespaces": "selection",
    "show_completions_on_input": true,
    "show_completion_documentation": true,
    "show_signature_help_after_edits": true,
    "auto_signature_help": false,
    // ---------------- AGENT SETTINGS ----------------
    // https://opencode.ai/go
    // Model                       Model training   Data retention
    // Grok 4.6                    Not used         30 days
    // GPT 5.6 Luna                Not used         30 days
    // GLM-5.3-Flash               Not used         0 days
    // GLM-5.3                     Not used         0 days
    // GLM-5.2                     Not used         0 days
    // GLM-5.1                     Not used         0 days
    // Kimi K3                     Not used         0 days
    // Kimi K2.7 Code              Not used         0 days
    // Kimi K2.6                   Not used         0 days
    // LongCat-2.0                 Not used         0 days
    // MiMo-V2.5-Pro               Not used         0 days
    // MiMo-V2.5                   Not used         0 days
    // Qwen3.8 Max                 Not used         0 days
    // Qwen3.8 Flash               Not used         0 days
    // Qwen3.7 Max                 Not used         0 days
    // Qwen3.7 Plus                Not used         0 days
    // Qwen3.6 Plus                Not used         0 days
    // MiniMax M3                  Not used         0 days
    // MiniMax M2.7                Not used         0 days
    // Muse Spark 1.3 Contributor  Used             Not ZDR
    // Muse Spark 1.2 Contributor  Used             Not ZDR
    // DeepSeek V4 Pro             Not used         0 days
    // DeepSeek V4 Flash           Not used         0 days
    // Hy4 preview                 Not used         0 days
    // Hy3                         Not used         0 days
    // Omen Alpha                  Not used         0 days
    "agent": {
        "sandbox_permissions": {
            "allow_unsandboxed": true
        },
        "auto_compact": { "threshold": 200000 },
        "use_modifier_to_send": true,
        "thinking_display": "always_expanded",
        "single_file_review": true,
        "enable_feedback": false,
        "sidebar_side": "left",
        "default_profile": "write",
        "dock": "right",
        "subagent_model": {
            "enable_thinking": false,
            "provider": "opencode",
            "model": "go/minimax-m3",
        },
        "default_model": {
            "effort": "high",
            "enable_thinking": true,
            "provider": "opencode",
            "model": "go/glm-5.2",
        },
        "inline_assistant_model": { "provider": "opencode", "model": "go/minimax-m3" },
    },
    "language_models": {
        "opencode": { "show_zen_models": false },
    },
    "show_edit_predictions": true,
    "edit_predictions": {
        "allow_data_collection": "no",
        "mode": "eager",
        "provider": "ollama",
        "ollama": { "model": "deepseek-coder:1.3b" },
        // "provider": "open_ai_compatible_api",
        // "open_ai_compatible_api": {
        //     "api_url": "https://opencode.ai/zen/go/v1/completions",
        //     "model": "opencode-go/glm-5.2",
        //     "prompt_format": "glm",
        //     "max_output_tokens": 256,
        // },
        "disabled_globs": [
            ".env",
            ".env.local",
            ".env.production",
            ".env.development",
            "application.properties",
            "application.yml",
            "application.yaml",
            ".properties",
            ".config",
            "config.json",
            "credentials.json",
            "secrets.json",
            ".aws/credentials",
            "secrets.yaml",
            ".htpasswd",
            "*.pfx",
            "*.p12",
            "*.pem",
            "*.key",
        ],
    },
    // ---------------- TERMINAL ----------------
    "terminal": {
        "button": true,
        "copy_on_select": false,
        "cursor_shape": "bar",
        "shell": { "program": "fish" },
        "working_directory": "current_project_directory",
        "toolbar": { "breadcrumbs": false },
        "detect_venv": "off",
    },
}
